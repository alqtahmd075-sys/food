# انسخ الملف ده باسم .env وعدّل القيم (للتشغيل على جهازك)
PORT=3003
JWT_SECRET=change_this_to_a_long_random_string

# قاعدة بيانات دائمة (اختياري محلياً، مهم على الاستضافة) — Turso:
# TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
# TURSO_AUTH_TOKEN=your_token_here

# اختياري: تغيير بيانات الأدمن (قبل أول تشغيل على قاعدة جديدة)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose_a_strong_password

# اختياري: عدم إضافة 8 طلبات تجريبية في لوحة الأدمن
# SEED_DEMO_ORDERS=false
